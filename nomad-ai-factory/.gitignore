# ─────────────────────────────────────────────
#  NOMAD AI Factory — .gitignore
#  npm workspaces: root / frontend / backend
# ─────────────────────────────────────────────

# ── 의존성 ────────────────────────────────────
node_modules/
.pnp
.pnp.js

# ── 빌드 산출물 ───────────────────────────────
dist/
dist-ssr/
build/
.vite/
*.local

# ── 환경 변수 (절대 커밋 금지) ────────────────
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.*.local

# ── 로그 ──────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ── TypeScript 캐시 ───────────────────────────
*.tsbuildinfo

# ── 테스트 / 커버리지 ─────────────────────────
coverage/
.nyc_output/

# ── OS 파일 ───────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
desktop.ini

# ── IDE / 에디터 ──────────────────────────────
.idea/
.vscode/settings.json
.vscode/launch.json
*.swp
*.swo
*~

# ── Claude Code 개인 설정 ─────────────────────
# (CLAUDE.md 자체는 커밋 대상 — 이 폴더만 제외)
.claude/

# ── 디자인 핸드오프 아카이브 ──────────────────
# 로컬 참고용 파일 — 원본 저장소에 불필요
aa.zip
aa-extracted/

# ── 기타 임시 파일 ────────────────────────────
*.tmp
*.temp
.cache/
