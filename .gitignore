# ─────────────────────────────────────────────
#  platform (모노레포 루트) — .gitignore
# ─────────────────────────────────────────────

# ── 의존성 ────────────────────────────────────
node_modules/
.pnp
.pnp.js

# ── 빌드 산출물 ───────────────────────────────
dist/
dist-ssr/
build/
.vite/
.next/
out/

# ── 환경 변수 (절대 커밋 금지) ────────────────
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.*.local

# ── 로그 ──────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ── TypeScript 캐시 ───────────────────────────
*.tsbuildinfo

# ── 테스트 / 커버리지 ─────────────────────────
coverage/
.nyc_output/

# ── 디자인 아카이브 · 임시 파일 ─────────────────
# 각 프로젝트 폴더의 zip 원본 (압축 해제 후 불필요)
*.zip
*.tar.gz
*.rar

# ── OS 파일 ───────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
desktop.ini

# ── IDE / 에디터 ──────────────────────────────
.idea/
.vscode/settings.json
.vscode/launch.json
*.swp
*.swo
*~

# ── Claude Code 개인 설정 ─────────────────────
# (각 프로젝트의 CLAUDE.md 자체는 커밋 대상)
.claude/

# ── 기타 임시 파일 ────────────────────────────
*.tmp
*.temp
.cache/
